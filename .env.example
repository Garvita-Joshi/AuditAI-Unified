DATABASE_URL=postgresql+psycopg2://localhost:5433/auditai_unified
COMPANY_EMAIL_DOMAINS=yourcompany.com
JWT_SECRET_KEY=replace-with-a-long-random-secret
AUTH_DEBUG_OTP=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FRONTEND_ORIGINS=http://127.0.0.1:5190

# === Dograh Voice AI Integration ===
# When true, AuditAI runs in safe simulation mode: validates payloads, returns mock run IDs, and NEVER dials
DOGRAH_DRY_RUN=true
DOGRAH_API_KEY=your_dograh_api_key_here
DOGRAH_API_URL=https://api.dograh.com/api/v1/public/agent
DOGRAH_TEST_API_URL=https://api.dograh.com/api/v1/public/agent/test
# API Trigger Path segment from Dograh "AuditAI Vendor RFQ Follow-up" agent
DOGRAH_TRIGGER_PATH=fe74624e-3928-482b-821e-9be6416df7c8
# Secret used to authenticate post-call webhooks from Dograh
DOGRAH_WEBHOOK_SECRET=your_dograh_webhook_secret_here
DOGRAH_TIMEOUT_SECONDS=30

# === Twilio Telephony Integration ===
# Credentials from your Twilio Console (https://console.twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# === Exotel OpenVBX Indian Telephony Integration ===
# Credentials from your Exotel Dashboard -> Settings -> API Credentials
EXOTEL_ACCOUNT_SID=your_exotel_account_sid_here
EXOTEL_API_KEY=your_exotel_api_key_here
EXOTEL_API_TOKEN=your_exotel_api_token_here
EXOTEL_BASE_URL=https://api.in.exotel.com
EXOTEL_CALLER_ID=your_provisioned_exophone_number

# === Voice Calling Safety Controls ===
# Comma-separated E.164 authorized phone numbers for testing (e.g. +919876543210)
VOICE_AUTHORIZED_ALLOWLIST=+919876543210
VOICE_MAX_DAILY_CALLS=1
VOICE_MAX_DURATION_SECONDS=120
VOICE_EMERGENCY_DISABLE=false
